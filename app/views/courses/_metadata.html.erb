<div class="mt-3 space-y-2 text-sm text-muted-ink wrap-anywhere">
  <% if course.generation_model.present? %>
    <p class="flex flex-wrap gap-x-4 gap-y-1">
      <span data-course-ai-model="<%= course.generation_model %>"><%= t("settings.course_model", provider: "Codex", model: course.generation_model_name.presence || course.generation_model) %></span>
      <span data-course-ai-reasoning="<%= course.generation_reasoning_effort %>"><%= t("settings.course_reasoning", effort: course.generation_reasoning_effort.present? ? reasoning_label(course.generation_reasoning_effort) : t("settings.reasoning_not_recorded")) %></span>
    </p>
  <% end %>
  <p><%= render "courses/date", course: course %></p>
</div>
