<nav class="mt-8 flex flex-wrap gap-2" aria-label="<%= t("home.category_filters") %>" data-motion="enter" data-motion-delay="1">
  <%= link_to public_send(filter_path), class: class_names("btn min-h-11 h-auto rounded-full px-4 py-2 font-medium", @selected_category ? "btn-ghost border-base-300" : "btn-primary"), aria: { current: @selected_category ? nil : "page" } do %>
    <%= t("home.all_categories") %> <span class="text-xs tabular-nums"><%= @category_counts.values.sum %></span>
  <% end %>
  <% @categories.each do |category| %>
    <% selected = category == @selected_category %>
    <%= link_to public_send(filter_path, category: category.id), class: class_names("btn min-h-11 h-auto max-w-full rounded-full px-4 py-2 font-medium whitespace-normal wrap-anywhere", selected ? "btn-primary" : "btn-ghost border-base-300"), aria: { current: selected ? "page" : nil } do %>
      <%= category.name %> <span class="text-xs tabular-nums"><%= @category_counts.fetch(category.id) %></span>
    <% end %>
  <% end %>
</nav>
