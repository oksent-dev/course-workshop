<article class="card min-w-0 border border-base-300 bg-base-200 sm:only:col-span-2" data-motion="enter" data-motion-delay="<%= local_assigns.fetch(:course_counter, 0) % 3 + 1 %>">
  <div class="card-body gap-3 p-6 sm:p-8">
    <h3 class="font-serif text-2xl leading-tight font-semibold">
      <%= link_to course.title, course_path(course), lang: course.language, class: "inline-flex min-h-11 max-w-full items-center rounded-field wrap-anywhere text-primary underline decoration-1 underline-offset-4 hover:decoration-2" %>
    </h3>
    <p lang="<%= course.language %>" class="max-w-prose font-serif text-lg leading-relaxed"><%= course.description %></p>
    <p class="text-sm text-muted-ink"><%= course_language_label(course) %></p>
    <% progress = @progress_by_course.fetch(course.id) %>
    <%= render "courses/progress", progress: progress %>
    <% if progress.resume_lesson %>
      <div class="card-actions mt-2">
        <%= link_to course_progress_action(progress), course_lesson_path(course, progress.resume_lesson), class: "btn btn-primary min-h-11 max-w-full h-auto py-3" %>
      </div>
    <% end %>
  </div>
</article>
