<% content_for :title, "#{@course.title} · #{t("app.name")}" %>
<header class="wrap-anywhere" data-motion="enter">
  <p class="text-sm text-muted-ink"><%= @course.category.name %></p>
  <h1 lang="<%= @course.language %>" class="mt-2 font-serif text-[clamp(2rem,5vw,3rem)] leading-[1.15] font-medium tracking-tight"><%= @course.title %></h1>
  <p lang="<%= @course.language %>" class="mt-4 max-w-prose font-serif text-xl leading-relaxed"><%= @course.description %></p>
  <p class="mt-3 text-sm text-muted-ink"><%= course_language_label(@course) %></p>
</header>

<section class="mt-8 max-w-prose rounded-box bg-base-200 p-6" data-motion="enter" data-motion-delay="1">
  <h2 class="font-serif text-2xl font-semibold"><%= t("courses.outline") %></h2>
  <% if @lessons.any? %>
    <div class="mt-4"><%= render "courses/progress", progress: @progress %></div>
    <%= render "lessons/outline", course: @course, lessons: @lessons, current_lesson: nil, progress: @progress %>
    <%= link_to course_progress_action(@progress), course_lesson_path(@course, @progress.resume_lesson), class: "btn btn-primary mt-4 min-h-11 max-w-full h-auto py-3" %>
  <% else %>
    <p class="mt-3 text-muted-ink"><%= t("courses.no_lessons") %></p>
  <% end %>
</section>
