<div class="lesson-selection-action" hidden data-lesson-chat-target="selectionAction">
  <button type="button" class="btn btn-primary min-h-11 h-auto max-w-full whitespace-normal py-3"
    aria-keyshortcuts="Alt+Enter" title="Alt+Enter" data-lesson-chat-target="selectionButton"
    data-action="pointerdown->lesson-chat#preserveSelection click->lesson-chat#askSelection"><%= t("conversation.ask_selection") %></button>
</div>

<div data-controller="conversation"
  data-conversation-key-value="<%= context[:key] %>"
  data-conversation-url-value="<%= context[:url] %>"
  data-conversation-network-error-value="<%= t("conversation.network_error") %>"
  data-conversation-sending-value="<%= t("conversation.sending") %>"
  data-action="turbo:load@document->conversation#navigate pagehide@window->conversation#save lesson-chat:opened->conversation#open lesson-chat:closed->conversation#close lesson-chat:quoted->conversation#quote">
  <button type="button" class="lesson-chat-launcher btn btn-primary btn-circle size-16 p-4" disabled
    aria-label="<%= t("conversation.open") %>" title="<%= t("conversation.open") %>"
    aria-expanded="false" aria-controls="lesson-chat-panel" aria-haspopup="dialog"
    data-lesson-chat-target="launcher" data-action="lesson-chat#open">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="size-8 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 11.5a8 8 0 0 1-8 8H5l-3 2v-10a9 9 0 0 1 18 0Z"/>
      <path d="M7 10h8M7 14h5"/>
    </svg>
  </button>
  <dialog id="lesson-chat-panel" class="lesson-chat-panel" aria-labelledby="lesson-chat-heading"
    data-lesson-chat-target="panel" data-action="close->lesson-chat#closed">
    <header class="shrink-0 border-b border-base-300 bg-base-200">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h2 id="lesson-chat-heading" class="font-serif font-semibold"><%= t("conversation.modes.#{context[:mode]}") %></h2>
          <p lang="<%= course.language %>" class="mt-1 text-sm text-muted-ink wrap-anywhere" data-conversation-target="courseTitle"><%= course.title %></p>
        </div>
        <div class="flex shrink-0 gap-1">
          <button type="button" class="btn btn-ghost btn-circle min-h-11 min-w-11"
            aria-label="<%= t("conversation.expand") %>" title="<%= t("conversation.expand") %>"
            aria-controls="lesson-chat-panel" aria-pressed="false"
            data-lesson-chat-target="sizeToggle" data-action="lesson-chat#toggleSize"
            data-expand-label="<%= t("conversation.expand") %>" data-restore-label="<%= t("conversation.restore") %>">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="lesson-chat-expand-icon size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H3v5m0-5 7 7m6 11h5v-5m0 5-7-7"/></svg>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="lesson-chat-restore-icon size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 3 7 7m0-6v6H4m17 11-7-7m0 6v-6h6"/></svg>
          </button>
          <button type="button" class="btn btn-ghost btn-circle min-h-11 min-w-11"
            aria-label="<%= t("conversation.close") %>" title="<%= t("conversation.close") %>" data-action="lesson-chat#close">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
          </button>
        </div>
      </div>
      <p class="mt-2 text-sm text-muted-ink"><%= t("conversation.contexts.#{context[:mode]}") %></p>
    </header>
    <div class="shrink-0 border-b border-base-300 px-4 py-2" hidden data-conversation-target="updates">
      <button type="button" class="btn btn-outline min-h-11 h-auto w-full py-2 text-sm whitespace-normal" data-action="conversation#refreshPage"><%= t("conversation.updates") %></button>
    </div>
    <div class="lesson-chat-transcript p-4" role="log" aria-live="polite" aria-label="<%= t("conversation.history") %>"
      aria-busy="true" tabindex="0" data-conversation-target="scroll" data-action="scroll->conversation#save">
      <div data-conversation-target="activity" class="space-y-2 empty:hidden mb-4"></div>
      <div data-conversation-target="transcript">
      <div class="lesson-chat-loading space-y-3" data-conversation-target="loading">
        <p class="text-sm text-muted-ink"><%= t("conversation.loading") %></p>
        <div class="space-y-3" aria-hidden="true">
          <div class="skeleton h-3 w-full"></div>
          <div class="skeleton h-3 w-5/6"></div>
          <div class="skeleton h-3 w-2/3"></div>
        </div>
      </div>
      </div>
    </div>
    <div class="lesson-chat-composer border-t border-base-300 p-4">
      <p class="mb-2 text-sm text-muted-ink" hidden data-conversation-target="editorHint"></p>
      <p role="status" class="text-sm text-error-content" data-conversation-target="status"></p>
      <button type="button" class="btn btn-ghost mb-2 min-h-11 hidden" data-conversation-target="refresh" data-action="conversation#refresh"><%= t("conversation.refresh") %></button>
      <%= form_with url: context[:exchanges_url], class: "mx-auto max-w-[75ch]", data: { turbo: false, action: "submit->conversation#send", conversation_target: "form" } do |form| %>
        <p class="mb-2 line-clamp-2 text-sm text-muted-ink"><%= t("conversation.current_context") %> <span class="font-medium text-primary wrap-anywhere" data-conversation-target="contextLabel"><%= context[:label] %></span></p>
        <div class="mb-3 rounded-field bg-secondary p-3" hidden data-conversation-target="quotePreview">
          <div class="flex items-center justify-between gap-2">
            <p class="text-sm font-semibold"><%= t("conversation.selected_passage") %></p>
            <button type="button" class="btn btn-ghost min-h-11 h-auto px-2 text-sm" data-conversation-target="removeQuote" data-action="conversation#removeQuote"><%= t("conversation.remove_selection") %></button>
          </div>
          <p class="mb-2 text-xs text-muted-ink wrap-anywhere" data-conversation-target="quoteSource"></p>
          <blockquote class="overflow-y-auto border-s-2 border-primary ps-3 text-sm whitespace-pre-wrap wrap-anywhere" tabindex="0" data-conversation-target="quoteText"></blockquote>
        </div>
        <%= form.label :question, t("conversation.question"), class: "block text-sm font-medium" %>
        <%= form.text_area :question, required: true, maxlength: 4000, rows: 2,
          placeholder: t("conversation.placeholder"),
          class: "textarea mt-2 max-h-36 w-full border-muted-ink bg-base-100 text-base",
          data: { conversation_target: "question", lesson_chat_target: "question", action: "input->conversation#input" } %>
        <div class="mt-3 flex flex-wrap gap-2">
          <%= form.submit t("conversation.send"), class: "btn btn-primary min-h-11", disabled: true, data: { conversation_target: "submit" } %>
          <button type="button" class="btn btn-ghost min-h-11 hidden" data-conversation-target="cancel" data-action="conversation#cancel"><%= t("conversation.cancel") %></button>
        </div>
      <% end %>
    </div>
  </dialog>
  <noscript><p class="mt-6"><%= t("conversation.javascript_required") %></p></noscript>
</div>
