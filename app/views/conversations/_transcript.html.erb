<% if exchanges.empty? %>
  <p class="text-muted-ink"><%= t("conversation.empty") %></p>
<% else %>
  <ol class="space-y-6">
    <% exchanges.each do |exchange| %>
      <li class="space-y-3" data-exchange-id="<%= exchange.id %>" data-exchange-status="<%= exchange.status %>">
        <div class="rounded-box bg-secondary p-4">
          <p class="text-sm font-semibold"><%= t("conversation.you") %></p>
          <p class="mt-1 text-sm text-muted-ink"><%= exchange.lesson_context["title"].presence || t("courses.outline") %></p>
          <% if exchange.selected_text.present? %>
            <div class="mt-2 border-s-2 border-primary ps-3 text-sm">
              <p class="font-medium text-muted-ink"><%= t("conversation.selected_passage") %></p>
              <blockquote class="mt-1 max-h-32 overflow-y-auto whitespace-pre-wrap wrap-anywhere" tabindex="0"><%= exchange.selected_text %></blockquote>
            </div>
          <% end %>
          <p class="mt-1 whitespace-pre-wrap wrap-anywhere"><%= exchange.question %></p>
        </div>
        <div class="px-1" data-tutor-reply="true">
          <% if exchange.conversation.mode == "editor" %>
            <%= render "conversations/changes", exchange: exchange %>
          <% end %>
          <p class="text-sm font-semibold"><%= t("conversation.modes.#{exchange.lesson_context.fetch("mode", "tutor")}") %></p>
          <% if exchange.completed? %>
            <p class="mt-1 whitespace-pre-wrap wrap-anywhere"><%= exchange.answer %></p>
          <% elsif exchange.failed? || exchange.uncertain? %>
            <p class="mt-1 text-error-content"><%= t("conversation.errors.#{exchange.error_code}", default: t("conversation.errors.unavailable")) %></p>
            <p class="mt-1 text-sm text-muted-ink"><%= t("conversation.retry_hint") %></p>
          <% else %>
            <p class="mt-1 text-muted-ink"><%= t("conversation.states.#{exchange.cancel_requested_at? && exchange.pending? ? "cancelling" : exchange.status}") %></p>
          <% end %>
        </div>
      </li>
    <% end %>
  </ol>
<% end %>
