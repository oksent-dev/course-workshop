<div data-controller="demo-chat">
  <button type="button" class="lesson-chat-launcher btn btn-primary btn-circle size-16 p-4"
    aria-label="<%= t('conversation.open') %>" aria-expanded="false" aria-controls="demo-chat-panel" aria-haspopup="dialog"
    data-demo-chat-target="launcher" data-action="demo-chat#open">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="size-8 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 11.5a8 8 0 0 1-8 8H5l-3 2v-10a9 9 0 0 1 18 0Z"/><path d="M7 10h8M7 14h5"/>
    </svg>
  </button>
  <dialog id="demo-chat-panel" class="lesson-chat-panel" aria-labelledby="demo-chat-heading" aria-describedby="demo-chat-description"
    data-demo-chat-target="panel" data-action="close->demo-chat#closed keydown.esc->demo-chat#close">
    <header class="shrink-0 border-b border-base-300 bg-base-200">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h2 id="demo-chat-heading" class="font-serif font-semibold"><%= t("conversation.modes.tutor") %></h2>
          <p lang="<%= @course.language %>" class="mt-1 text-sm text-muted-ink wrap-anywhere"><%= @course.title %></p>
        </div>
        <button type="button" class="btn btn-ghost btn-circle min-h-11 min-w-11" aria-label="<%= t('conversation.close') %>" data-demo-chat-target="closeButton" data-action="demo-chat#close">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
        </button>
      </div>
    </header>
    <div class="lesson-chat-transcript p-4">
      <p class="badge badge-soft"><%= t("demo.badge") %></p>
      <p id="demo-chat-description" class="mt-4 leading-relaxed"><%= t("demo.chat_description") %></p>
    </div>
    <fieldset disabled class="lesson-chat-composer min-w-0 border-t border-base-300 p-4">
      <label for="demo-chat-question" class="block text-sm font-medium"><%= t("conversation.question") %></label>
      <textarea id="demo-chat-question" rows="2" class="textarea mt-2 w-full text-base" placeholder="<%= t('demo.chat_placeholder') %>"></textarea>
      <button type="button" class="btn btn-primary mt-3 min-h-11"><%= t("conversation.send") %></button>
    </fieldset>
  </dialog>
</div>
