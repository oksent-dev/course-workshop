<% content_for :title, "#{t("drafts.title")} · #{t("app.name")}" %>
<%= link_to t("home.library_title"), localized_root_path, class: "inline-flex min-h-11 items-center text-primary underline underline-offset-4" %>
<h1 class="mt-6 font-serif text-[clamp(2rem,5vw,3rem)] leading-tight font-medium"><%= t("drafts.title") %></h1>
<p class="mt-3 max-w-prose text-muted-ink"><%= t("drafts.introduction") %></p>
<% if @drafts.any? %>
  <ul class="mt-8 space-y-4">
    <% @drafts.each do |course| %>
      <li class="rounded-box border border-base-300 bg-base-200 p-6">
        <p class="text-sm text-muted-ink"><%= course.category.name %> · <%= course_language_label(course) %></p>
        <h2 class="mt-2 font-serif text-2xl font-semibold">
          <%= link_to course.title, draft_path(course.id), lang: course.language, class: "inline-flex min-h-11 items-center wrap-anywhere text-primary underline underline-offset-4" %>
        </h2>
        <p lang="<%= course.language %>" class="mt-2 max-w-prose wrap-anywhere"><%= course.description %></p>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="mt-8 rounded-box bg-base-200 p-6"><%= t("drafts.empty") %></p>
<% end %>
