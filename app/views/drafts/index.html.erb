<% content_for :title, "#{t("drafts.title")} · #{t("app.name")}" %>
<header data-motion="enter">
  <h1 class="font-serif text-[clamp(2rem,5vw,3rem)] leading-[1.15] font-medium tracking-tight"><%= t("drafts.title") %></h1>
  <p class="mt-3 max-w-prose text-muted-ink"><%= t("drafts.introduction") %></p>
</header>
<% if @drafts.any? %>
  <%= render "courses/category_filters", filter_path: :drafts_path %>
  <section class="mt-6" aria-label="<%= t("drafts.title") %>">
    <p class="mb-4 text-sm text-muted-ink" role="status" data-motion="enter" data-motion-delay="1"><%= t("drafts.results", count: @drafts.size) %></p>
    <div class="grid items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-3" data-course-grid>
      <%= render partial: "courses/course", collection: @drafts, locals: { draft: true } %>
    </div>
  </section>
<% else %>
  <section class="card mt-8 bg-base-200" aria-labelledby="empty-drafts-heading" data-motion="enter" data-motion-delay="1">
    <div class="card-body grid items-center gap-6 p-6 sm:grid-cols-[1fr_auto] sm:p-12">
      <div>
        <h2 id="empty-drafts-heading" class="font-serif text-2xl leading-snug font-semibold"><%= t("drafts.empty") %></h2>
        <p class="mt-2 max-w-prose font-serif text-lg leading-relaxed text-muted-ink"><%= t("drafts.empty_hint") %></p>
      </div>
      <%= render "pages/bookshelf" %>
    </div>
  </section>
<% end %>
