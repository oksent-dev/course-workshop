<% content_for :title, "#{@course.title} · #{t("drafts.title")}" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "lesson_math", "data-turbo-track": "dynamic" %>
<% end %>
<header class="wrap-anywhere" data-motion="enter">
  <p class="font-medium text-primary"><%= t("drafts.preview") %></p>
  <h1 lang="<%= @course.language %>" class="mt-2 font-serif text-[clamp(2rem,5vw,3rem)] leading-tight font-medium"><%= @course.title %></h1>
  <p lang="<%= @course.language %>" class="mt-3 max-w-prose font-serif text-xl leading-relaxed"><%= @course.description %></p>
</header>
<section aria-label="<%= t("drafts.approval") %>" class="mt-6 rounded-box bg-secondary p-6" data-motion="enter" data-motion-delay="1">
  <% generation = @course.course_generation %>
  <% incomplete = generation && !generation.completed? %>
  <p><%= t(incomplete ? "generation.incomplete_hint" : "drafts.review_hint") %></p>
  <% if @error %><p role="alert" class="mt-3 font-medium text-error-content"><%= @error %></p><% end %>
  <div class="mt-5 flex flex-wrap items-center gap-3" data-draft-actions>
    <% if generation && LocalGeneration.available?(request) %>
      <%= link_to t("generation.progress_title"), generation_path(generation), class: "btn btn-outline min-h-11 h-auto max-w-full py-3 whitespace-normal" %>
    <% end %>
    <%= render "drafts/approve_button", course: @course, disabled: @lessons.empty? || incomplete %>
  </div>
</section>
<% if @lessons.any? %>
  <div class="mt-8 grid items-start gap-6 md:grid-cols-[minmax(12rem,1fr)_minmax(0,2.6fr)] md:gap-8">
    <nav aria-label="<%= t("courses.outline") %>" class="rounded-box bg-base-200 p-4" data-motion="enter" data-motion-delay="1">
      <h2 class="font-semibold"><%= t("courses.outline") %></h2>
      <ol class="mt-3 space-y-1">
        <% @lessons.each_with_index do |lesson, index| %>
          <li><%= link_to "#{index + 1}. #{lesson.title}", draft_path(@course.id, lesson_id: lesson.id), lang: @course.language,
            aria: { current: ("page" if lesson == @lesson) },
            class: "block min-h-11 rounded-field px-3 py-2.5 wrap-anywhere text-primary underline underline-offset-4 hover:bg-secondary aria-[current=page]:bg-primary aria-[current=page]:text-primary-content" %></li>
        <% end %>
      </ol>
    </nav>
    <article class="min-w-0 max-w-[65ch]" lang="<%= @course.language %>" data-motion="enter" data-motion-delay="2">
      <h2 class="font-serif text-3xl font-semibold wrap-anywhere"><%= @lesson.title %></h2>
      <div class="lesson-content mt-6 font-serif text-xl leading-relaxed wrap-anywhere"><%= render_lesson_body(@lesson) %></div>
    </article>
  </div>
<% else %>
  <p class="mt-8 text-muted-ink"><%= t("courses.no_lessons") %></p>
<% end %>
