<% generation = course.course_generation %>
<div class="space-y-2 text-sm">
  <p class="font-medium text-primary"><%= generation ? t("generation.statuses.#{generation.status}") : t("drafts.manual") %></p>
  <p class="text-muted-ink"><%= t("drafts.lesson_count", count: @lesson_counts.fetch(course.id, 0)) %></p>
</div>
<div class="card-actions">
  <% label = generation && LocalGeneration.available?(request) ? t("generation.progress_title") : t("drafts.review") %>
  <%= link_to label, draft_entry_path(course), class: "btn btn-primary min-h-11 h-auto w-full py-3 whitespace-normal" %>
</div>
