<header data-motion="enter">
  <h1 class="font-serif text-[clamp(2rem,5vw,3rem)] leading-[1.15] font-medium tracking-tight"><%= t("home.library_title") %></h1>
  <p class="mt-3 max-w-prose text-muted-ink"><%= t("home.introduction") %></p>
</header>

<% if @categories.any? %>
  <%= render "courses/category_filters", filter_path: :localized_root_path %>
  <section class="mt-6" aria-label="<%= t("home.course_list") %>">
    <p class="mb-4 text-sm text-muted-ink" role="status" data-motion="enter" data-motion-delay="1"><%= t("home.results", count: @courses.size) %></p>
    <div class="grid items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-3" data-course-grid>
      <%= render @courses %>
    </div>
  </section>
<% else %>
  <section aria-labelledby="empty-library-heading" class="card mt-8 bg-base-200" data-motion="enter" data-motion-delay="1">
    <div class="card-body grid items-center gap-6 p-6 sm:grid-cols-[1fr_auto] sm:p-12">
      <div>
        <h2 id="empty-library-heading" class="font-serif text-2xl leading-snug font-semibold">
          <%= t("home.empty_title") %>
        </h2>
        <p class="mt-2 max-w-prose font-serif text-lg leading-relaxed text-muted-ink"><%= t("home.library_description") %></p>
      </div>
      <%= render "bookshelf" %>
    </div>
  </section>
<% end %>
