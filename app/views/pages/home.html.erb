<header class="flex flex-wrap items-end justify-between gap-6" data-motion="enter">
  <div>
    <h1 class="font-serif text-[clamp(2rem,5vw,3rem)] leading-[1.15] font-medium tracking-tight"><%= t("home.library_title") %></h1>
    <p class="mt-3 max-w-prose text-muted-ink"><%= t("home.introduction") %></p>
  </div>
  <div class="flex flex-wrap gap-2">
    <% if LocalAuthoring.available?(request) %>
      <%= link_to t("drafts.title"), drafts_path, class: "btn btn-ghost min-h-11" %>
    <% end %>
    <% if LocalGeneration.available?(request) %>
      <%= link_to t("generation.title"), new_generation_path, class: "btn btn-primary min-h-11" %>
    <% end %>
  </div>
</header>

<% if @categories.any? %>
  <nav class="mt-8 flex flex-wrap gap-2" aria-label="<%= t("home.category_filters") %>" data-motion="enter" data-motion-delay="1">
    <%= link_to localized_root_path, class: class_names("btn min-h-11 h-auto rounded-full px-4 py-2 font-medium", @selected_category ? "btn-ghost border-base-300" : "btn-primary"), aria: { current: @selected_category ? nil : "page" } do %>
      <%= t("home.all_categories") %> <span class="text-xs tabular-nums"><%= @category_counts.values.sum %></span>
    <% end %>
    <% @categories.each do |category| %>
      <% selected = category == @selected_category %>
      <%= link_to localized_root_path(category: category.id), class: class_names("btn min-h-11 h-auto max-w-full rounded-full px-4 py-2 font-medium whitespace-normal wrap-anywhere", selected ? "btn-primary" : "btn-ghost border-base-300"), aria: { current: selected ? "page" : nil } do %>
        <%= category.name %> <span class="text-xs tabular-nums"><%= @category_counts.fetch(category.id) %></span>
      <% end %>
    <% end %>
  </nav>
  <section class="mt-6" aria-label="<%= t("home.course_list") %>">
    <p class="mb-4 text-sm text-muted-ink" role="status" data-motion="enter" data-motion-delay="1"><%= t("home.results", count: @courses.size) %></p>
    <div class="grid items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-3" data-course-grid>
      <%= render @courses %>
    </div>
  </section>
<% else %>
  <section aria-labelledby="empty-library-heading" class="card mt-8 bg-base-200" data-motion="enter" data-motion-delay="1">
    <div class="card-body grid items-center gap-6 p-6 sm:grid-cols-[1fr_auto] sm:p-12">
      <div>
        <h2 id="empty-library-heading" class="font-serif text-2xl leading-snug font-semibold">
          <%= t("home.empty_title") %>
        </h2>
        <p class="mt-2 max-w-prose font-serif text-lg leading-relaxed text-muted-ink"><%= t("home.library_description") %></p>
      </div>
      <%= render "bookshelf" %>
    </div>
  </section>
<% end %>
