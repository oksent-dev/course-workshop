<header class="border-b border-base-300" data-site-header>
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-2 gap-y-3 px-4 py-4 sm:gap-x-6 sm:px-8 lg:grid lg:grid-cols-[auto_1fr_auto_auto]">
    <%= link_to localized_root_path, aria: { label: t("app.name") }, data: { site_brand: true },
      class: "order-1 inline-flex min-h-11 min-w-0 max-w-full w-fit items-center gap-2.5 rounded-field font-medium wrap-anywhere" do %>
      <%= image_tag "logo.svg", width: 36, height: 36, alt: "", class: "size-9 shrink-0" %>
      <span class="min-w-0">
        <span class="block leading-tight"><%= t("app.name") %></span>
        <span class="mt-1 block text-[0.6875rem] leading-snug font-normal text-muted-ink sm:text-xs"><%= t("app.tagline") %></span>
      </span>
    <% end %>
    <div class="order-3 flex w-full flex-wrap items-center justify-between gap-2 lg:contents">
    <nav aria-label="<%= t("navigation.main") %>" class="flex flex-wrap items-center gap-1 lg:order-2 lg:justify-self-end" data-primary-navigation>
      <% active = navigation_section == :library %>
      <%= link_to t("navigation.library"), localized_root_path, aria: { current: ("page" if active) },
        class: class_names("inline-flex min-h-11 items-center rounded-field px-2 text-sm font-medium hover:bg-secondary sm:px-3", active ? "bg-secondary text-primary underline decoration-2 underline-offset-8" : "text-muted-ink") %>
      <% if LocalAuthoring.available?(request) %>
        <% active = navigation_section == :drafts %>
        <%= link_to t("navigation.drafts"), drafts_path, aria: { current: ("page" if active) },
          class: class_names("inline-flex min-h-11 items-center rounded-field px-2 text-sm font-medium hover:bg-secondary sm:px-3", active ? "bg-secondary text-primary underline decoration-2 underline-offset-8" : "text-muted-ink") %>
      <% end %>
    </nav>
    <% if DemoMode.enabled? || LocalGeneration.available?(request) %>
      <%= link_to t("generation.title"), new_generation_path,
        aria: { current: ("page" if navigation_section == :create) },
        class: class_names("btn btn-primary min-h-11 h-auto max-w-full px-3 py-3 text-sm whitespace-normal lg:order-3", "underline decoration-2 underline-offset-4" => navigation_section == :create) %>
    <% end %>
    </div>
    <div class="order-2 flex items-center justify-self-end gap-1 lg:order-4">
      <%= render "layouts/language_menu" %>
      <% if DemoMode.enabled? || LocalAi.available?(request) %>
        <%= link_to settings_path, title: t("settings.title"), aria: { label: t("settings.title"), current: ("page" if navigation_section == :settings) },
          class: class_names("btn btn-ghost btn-circle order-3 min-h-11 min-w-11", "bg-secondary text-primary" => navigation_section == :settings) do %>
          <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 3-.6 2.4-2 .9-2.2-.7-2 3.4 1.7 1.7v2.6L2.2 15l2 3.4 2.2-.7 2 .9L9 21h4l.6-2.4 2-.9 2.2.7 2-3.4-1.7-1.7v-2.6L19.8 9l-2-3.4-2.2.7-2-.9L13 3z"/><circle cx="11" cy="12" r="3"/>
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>
</header>
