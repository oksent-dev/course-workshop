<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= t("app.description") %>">
    <meta name="turbo-cache-control" content="no-cache">
    <meta name="turbo-prefetch" content="false">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body class="min-h-screen bg-base-100 font-sans text-base-content antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-10 focus:rounded-field focus:bg-base-100 focus:p-3">
      <%= t("navigation.skip_to_content") %>
    </a>
    <header class="border-b border-base-300">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4 sm:px-8">
        <%= link_to localized_root_path, class: "inline-flex min-h-11 items-center gap-2 rounded-field font-medium" do %>
          <svg aria-hidden="true" viewBox="0 0 32 32" class="size-8 rounded-field bg-secondary p-1.5 text-primary" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
            <path d="M3 6c5-1 9 0 13 3 4-3 8-4 13-3v20c-5-1-9 0-13 2-4-2-8-3-13-2zM16 9v19"/>
          </svg>
          <%= t("app.name") %>
        <% end %>
        <nav aria-label="<%= t("navigation.language") %>" class="flex items-center gap-1">
          <% I18n.available_locales.each do |locale| %>
            <% current = locale == I18n.locale %>
            <%= link_to t("languages.#{locale}"), url_for(request.path_parameters.merge(locale: locale)),
                lang: locale, hreflang: locale,
                aria: { current: current ? "page" : nil },
                class: class_names("btn min-h-11 text-base font-medium", current ? "btn-primary underline underline-offset-4" : "btn-ghost") %>
          <% end %>
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1" class="mx-auto max-w-5xl px-4 py-12 sm:px-8">
      <% if notice %><p role="status" class="mb-6 rounded-box bg-secondary p-4"><%= notice %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
