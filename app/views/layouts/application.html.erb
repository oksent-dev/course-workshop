<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= t("app.description") %>">
    <meta name="turbo-cache-control" content="no-cache">
    <meta name="turbo-prefetch" content="false">
    <%= favicon_link_tag "/icon.png", rel: "icon", type: "image/png", sizes: "32x32" %>
    <%= favicon_link_tag "/icon.svg", rel: "icon", type: "image/svg+xml", sizes: "any" %>
    <%= favicon_link_tag "/apple-touch-icon.png", rel: "apple-touch-icon", type: "image/png", sizes: "180x180" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body class="min-h-screen bg-base-100 font-sans text-base-content antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-10 focus:rounded-field focus:bg-base-100 focus:p-3">
      <%= t("navigation.skip_to_content") %>
    </a>
    <%= render "layouts/navigation" %>
    <main id="main-content" tabindex="-1" class="mx-auto max-w-5xl px-4 py-12 wrap-anywhere sm:px-8">
      <% if DemoMode.enabled? %>
        <p class="mb-6 flex flex-wrap items-start gap-3 text-sm text-muted-ink" data-demo-notice>
          <span class="badge badge-soft shrink-0"><%= t("demo.badge") %></span>
          <span class="min-w-0 wrap-anywhere"><%= t("demo.introduction") %></span>
        </p>
      <% end %>
        <% if alert %><p role="alert" class="mb-6 rounded-box bg-base-200 p-4"><%= alert %></p><% end %>
      <% if notice %><p role="status" class="mb-6 rounded-box bg-secondary p-4" data-motion="enter"><%= notice %></p><% end %>
      <%= yield %>
    </main>
    <% if DemoMode.enabled? && @course&.published? %>
      <%= render "conversations/demo_panel" %>
    <% elsif (context = assistant_page_context) %>
      <div hidden data-assistant-context="<%= context.to_json %>"></div>
      <div id="<%= context[:key].tr(':', '-') %>-<%= I18n.locale %>" data-turbo-permanent
        data-controller="lesson-chat" data-lesson-chat-key-value="<%= context[:key] %>"
        data-lesson-chat-limit-value="<%= Exchange::MAX_SELECTION_LENGTH %>"
        data-lesson-chat-selection-label-value="<%= t("conversation.ask_selection") %>"
        data-lesson-chat-selection-limit-value="<%= t("conversation.selection_limit", count: Exchange::MAX_SELECTION_LENGTH) %>"
        data-action="turbo:load@document->lesson-chat#navigate selectionchange@document->lesson-chat#selectionChanged pointerdown@document->lesson-chat#pointerDown pointerup@document->lesson-chat#pointerUp pointercancel@document->lesson-chat#pointerUp keydown@document->lesson-chat#keyDown resize@window->lesson-chat#reposition scroll@window->lesson-chat#hideSelection">
        <%= render "conversations/panel", course: @course, context: context %>
      </div>
    <% end %>
  </body>
</html>
