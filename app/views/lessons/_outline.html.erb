<ol class="mt-3 space-y-1">
  <% lessons.each_with_index do |lesson, index| %>
    <li>
      <%= link_to course_lesson_path(course, lesson), aria: { current: ("page" if lesson == current_lesson) },
            class: "flex min-h-11 items-baseline gap-3 rounded-field px-3 py-2.5 text-primary hover:bg-secondary aria-[current=page]:bg-primary aria-[current=page]:font-semibold aria-[current=page]:text-primary-content" do %>
        <span aria-hidden="true" class="shrink-0 tabular-nums whitespace-nowrap"><%= index + 1 %>.</span>
        <span class="min-w-0 wrap-anywhere">
          <span lang="<%= course.language %>"><%= lesson.title %></span>
          <% if progress.completed?(lesson) %>
            <span class="mt-1 block text-sm"><span aria-hidden="true">✓ </span><%= t("learning_progress.completed") %></span>
          <% end %>
        </span>
      <% end %>
    </li>
  <% end %>
</ol>
