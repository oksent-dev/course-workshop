<% content_for :title, "#{@lesson.title} · #{@course.title}" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "lesson_math", "data-turbo-track": "dynamic" %>
<% end %>
<div class="pb-16" data-controller="<%= "lesson-chat" if LocalAi.available?(request) %>"
  data-lesson-chat-limit-value="<%= Exchange::MAX_SELECTION_LENGTH %>"
  data-lesson-chat-selection-label-value="<%= t("conversation.ask_selection") %>"
  data-lesson-chat-selection-limit-value="<%= t("conversation.selection_limit", count: Exchange::MAX_SELECTION_LENGTH) %>"
  data-action="selectionchange@document->lesson-chat#selectionChanged pointerdown@document->lesson-chat#pointerDown pointerup@document->lesson-chat#pointerUp pointercancel@document->lesson-chat#pointerUp keydown@document->lesson-chat#keyDown resize@window->lesson-chat#reposition scroll@window->lesson-chat#hideSelection">
<nav aria-label="<%= t("reader.location") %>" class="flex flex-wrap items-baseline gap-x-2 text-sm">
  <%= link_to @course.title, course_path(@course), lang: @course.language, class: "inline-flex min-h-11 max-w-full items-center wrap-anywhere text-primary underline underline-offset-4" %>
</nav>

<div class="mt-8 grid items-start gap-6 md:grid-cols-[minmax(12rem,1fr)_minmax(0,2.6fr)] md:gap-8">
  <aside class="hidden rounded-box bg-base-200 p-4 md:block" aria-label="<%= t("courses.outline") %>" data-motion="enter">
    <h2 class="px-3 text-base font-semibold"><%= t("courses.outline") %></h2>
    <div class="mt-3 px-3"><%= render "courses/progress", progress: @progress %></div>
    <%= render "outline", course: @course, lessons: @lessons, current_lesson: @lesson, progress: @progress %>
  </aside>
  <details class="rounded-box bg-base-200 p-4 md:hidden" data-motion="enter">
    <summary class="min-h-11 cursor-pointer content-center font-semibold"><%= t("courses.outline") %></summary>
    <div class="mt-3"><%= render "courses/progress", progress: @progress %></div>
    <%= render "outline", course: @course, lessons: @lessons, current_lesson: @lesson, progress: @progress %>
  </details>

  <article class="min-w-0 max-w-[65ch]" data-motion="enter" data-motion-delay="1">
    <p class="text-sm font-medium text-muted-ink"><%= t("reader.position", number: @lesson_number, total: @lessons.size) %></p>
    <h1 lang="<%= @course.language %>" class="mt-2 font-serif text-[clamp(2rem,5vw,3rem)] leading-[1.15] font-medium tracking-tight wrap-anywhere"><%= @lesson.title %></h1>
    <div lang="<%= @course.language %>" class="lesson-content mt-6 font-serif text-xl leading-relaxed wrap-anywhere" data-lesson-chat-target="content">
      <%= render_lesson_body(@lesson) %>
    </div>

    <section id="lesson-completion" aria-labelledby="completion-heading" class="mt-8 scroll-mt-6 rounded-box bg-secondary p-6">
      <h2 id="completion-heading" class="font-serif text-2xl font-semibold"><%= t("learning_progress.heading") %></h2>
      <% if @progress.completed?(@lesson) %>
        <p role="status" class="mt-3 font-medium"><span aria-hidden="true">✓ </span><%= t("learning_progress.lesson_completed") %></p>
        <%= button_to t("learning_progress.undo"), course_lesson_completion_path(@course, @lesson), method: :delete, class: "btn btn-ghost mt-4 min-h-11 max-w-full h-auto py-3" %>
      <% else %>
        <p class="mt-3"><%= t("learning_progress.hint") %></p>
        <%= button_to t("learning_progress.mark_complete"), course_lesson_completion_path(@course, @lesson), class: "btn btn-primary mt-4 min-h-11 max-w-full h-auto py-3" %>
      <% end %>
    </section>

    <nav aria-label="<%= t("reader.lesson_navigation") %>" class="mt-6 flex flex-wrap gap-3 border-t border-base-300 pt-6">
      <% if @previous_lesson %>
        <%= link_to t("reader.previous"), course_lesson_path(@course, @previous_lesson), rel: "prev", class: "btn btn-ghost min-h-11" %>
      <% end %>
      <% if @next_lesson %>
        <%= link_to t("reader.next"), course_lesson_path(@course, @next_lesson), rel: "next", class: class_names("btn min-h-11", @progress.completed?(@lesson) ? "btn-primary" : "btn-ghost") %>
      <% else %>
        <%= link_to t("reader.back_to_course"), course_path(@course), class: "btn btn-ghost min-h-11 max-w-full h-auto py-3" %>
      <% end %>
    </nav>
  </article>
</div>
<% if LocalAi.available?(request) %>
  <%= render "conversations/panel", course: @course, lesson: @lesson %>
<% end %>
</div>
