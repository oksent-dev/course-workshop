<% content_for :title, "#{@lesson.title} · #{@course.title}" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "lesson_math", "data-turbo-track": "dynamic" %>
<% end %>
<div class="pb-16">
<nav aria-label="<%= t("reader.location") %>">
  <%= link_to course_path(@course), class: "inline-flex min-h-11 max-w-full items-center gap-3 rounded-box border border-base-300 px-4 py-3 text-primary hover:border-primary hover:bg-secondary" do %>
    <svg aria-hidden="true" class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m10 6-6 6 6 6M4 12h16"/></svg>
    <span class="min-w-0">
      <span class="block text-xs text-muted-ink"><%= t("reader.back_to_course") %></span>
      <span lang="<%= @course.language %>" class="mt-1 block text-sm font-medium wrap-anywhere"><%= @course.title %></span>
    </span>
  <% end %>
</nav>

<div class="mt-8 grid items-start gap-6 md:grid-cols-[minmax(12rem,1fr)_minmax(0,2.6fr)] md:gap-8">
  <aside class="hidden rounded-box bg-base-200 p-4 md:block" aria-label="<%= t("courses.outline") %>" data-motion="enter">
    <h2 class="px-3 text-base font-semibold"><%= t("courses.outline") %></h2>
    <div data-reader-progress><%= render "reader_progress", course: @course, lessons: @lessons, lesson: @lesson, progress: @progress %></div>
  </aside>
  <details class="rounded-box bg-base-200 p-4 md:hidden" data-motion="enter">
    <summary class="min-h-11 cursor-pointer content-center font-semibold"><%= t("courses.outline") %></summary>
    <div data-reader-progress><%= render "reader_progress", course: @course, lessons: @lessons, lesson: @lesson, progress: @progress %></div>
  </details>

  <article class="min-w-0 max-w-[65ch]" data-motion="enter" data-motion-delay="1">
    <p class="text-sm font-medium text-muted-ink"><%= t("reader.position", number: @lesson_number, total: @lessons.size) %></p>
    <h1 lang="<%= @course.language %>" class="mt-2 font-serif text-[clamp(2rem,5vw,3rem)] leading-[1.15] font-medium tracking-tight wrap-anywhere"><%= @lesson.title %></h1>
    <div lang="<%= @course.language %>" class="lesson-content mt-6 font-serif text-xl leading-relaxed wrap-anywhere" data-assistant-content>
      <%= render_lesson_body(@lesson) %>
    </div>

    <section id="lesson-completion" aria-labelledby="completion-heading" class="mt-8 scroll-mt-6 rounded-box bg-secondary p-6"
      data-controller="lesson-completion" data-action="turbo:submit-end->lesson-completion#restoreFocus">
      <%= render "completion", course: @course, lesson: @lesson, progress: @progress %>
    </section>

    <nav id="lesson-navigation" aria-label="<%= t("reader.lesson_navigation") %>" class="mt-6 flex flex-wrap gap-3 border-t border-base-300 pt-6">
      <%= render "navigation", course: @course, lessons: @lessons, lesson: @lesson, progress: @progress %>
    </nav>
  </article>
</div>
</div>
