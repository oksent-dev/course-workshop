<% content_for :title, t("generation.progress_title") %>
<%= link_to t("generation.title"), new_generation_path, class: "inline-flex min-h-11 items-center text-primary underline underline-offset-4" %>
<h1 class="mt-6 font-serif text-[clamp(2rem,5vw,3rem)] leading-tight font-medium"><%= t("generation.progress_title") %></h1>
<p class="mt-3 max-w-prose font-serif text-xl leading-relaxed wrap-anywhere"><%= @generation.topic %></p>
<div class="mt-8 max-w-2xl" data-controller="generation" data-generation-url-value="<%= generation_path(@generation, format: :json) %>"
  data-generation-busy-value="<%= @generation.pending? %>" data-generation-version-value="<%= generation_version %>" data-generation-network-error-value="<%= t("generation.network_error") %>">
  <div data-generation-target="status"><%= render "status" %></div>
  <p role="alert" class="mt-4 text-muted-ink" data-generation-target="error"></p>
  <button type="button" class="btn btn-ghost mt-2 min-h-11 hidden" data-generation-target="refresh" data-action="generation#refresh"><%= t("generation.refresh") %></button>
</div>
