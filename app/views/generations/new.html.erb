<% content_for :title, t("generation.title") %>
<%= link_to t("home.library_title"), localized_root_path, class: "inline-flex min-h-11 items-center text-primary underline underline-offset-4" %>
<header data-motion="enter">
  <h1 class="mt-6 font-serif text-[clamp(2rem,5vw,3rem)] leading-tight font-medium"><%= t("generation.title") %></h1>
  <p class="mt-3 max-w-prose font-serif text-xl leading-relaxed"><%= t("generation.introduction") %></p>
</header>
<%= form_with model: @generation, url: generations_path, class: "mt-8 max-w-2xl space-y-6 rounded-box bg-base-200 p-6 sm:p-8", data: { motion: "enter", motion_delay: "1" } do |form| %>
  <% if @error %><p role="alert" class="font-medium text-error-content"><%= @error %></p><% end %>
  <%= form.hidden_field :request_key %>
  <div>
    <%= form.label :topic, t("generation.topic"), class: "block font-semibold" %>
    <%= form.text_area :topic, required: true, maxlength: 2000, rows: 5, placeholder: t("generation.placeholder"),
      aria: { describedby: "topic-hint" }, class: "textarea mt-2 w-full border-base-content/50 bg-base-100 text-base" %>
    <p id="topic-hint" class="mt-2 text-sm text-muted-ink"><%= t("generation.topic_hint") %></p>
  </div>
  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :language, t("generation.language"), class: "block font-semibold" %>
      <%= form.select :language, [["Polski", "pl"], ["English", "en"]], {}, class: "select mt-2 w-full border-base-content/50 bg-base-100 text-base" %>
    </div>
    <div>
      <%= form.label :lesson_count, t("generation.lesson_count"), class: "block font-semibold" %>
      <%= form.select :lesson_count, (3..6).map { |count| [count, count] }, {}, class: "select mt-2 w-full border-base-content/50 bg-base-100 text-base" %>
    </div>
  </div>
  <p class="text-sm leading-relaxed text-muted-ink"><%= t("generation.consent") %></p>
  <%= form.submit t("generation.submit"), class: "btn btn-primary min-h-11 h-auto max-w-full py-3", data: { turbo_submits_with: t("generation.submitting") } %>
<% end %>
<% if @recent.any? %>
  <section class="mt-10 max-w-2xl" aria-labelledby="recent-heading" data-motion="enter" data-motion-delay="2">
    <h2 id="recent-heading" class="font-serif text-2xl font-semibold"><%= t("generation.recent") %></h2>
    <ul class="mt-4 divide-y divide-base-300">
      <% @recent.each do |generation| %>
        <li class="py-3 wrap-anywhere">
          <%= link_to generation.course.title, generation_path(generation), class: "inline-flex min-h-11 items-center text-primary underline underline-offset-4" %>
          <p class="text-sm text-muted-ink"><%= t("generation.statuses.#{generation.status}") %></p>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
