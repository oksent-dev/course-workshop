<% content_for :title, "#{t('settings.title')} · #{t('app.name')}" %>
<header data-motion="enter">
  <h1 class="font-serif text-[clamp(2rem,5vw,3rem)] leading-tight font-medium"><%= t("settings.title") %></h1>
  <p class="mt-3 max-w-prose font-serif text-xl leading-relaxed"><%= t("settings.introduction") %></p>
</header>
<%= form_with model: @settings, url: settings_path, method: :patch, class: "mt-8 max-w-2xl space-y-7 rounded-box bg-base-200 p-6 sm:p-8", data: { motion: "enter", motion_delay: "1" } do |form| %>
  <%= form.hidden_field :lock_version %>
  <% if @error %><p role="alert" class="font-medium"><%= @error %></p><% end %>
  <div>
    <label for="ai-provider" class="block font-semibold"><%= t("settings.provider") %></label>
    <input id="ai-provider" type="text" value="Codex" readonly aria-describedby="provider-hint" class="input mt-2 w-full border-base-300 bg-base-100 text-base">
    <p id="provider-hint" class="mt-2 text-sm text-muted-ink"><%= t("settings.provider_hint") %></p>
  </div>
  <div>
    <%= form.label :model, t("settings.model"), class: "block font-semibold" %>
    <% choices = @models.map { |model| [ model["id"] == LocalAi::DEFAULT_MODEL ? t("settings.default_model", name: model["name"]) : model["name"], model["id"] ] } %>
    <% unless choices.any? { |_, id| id == @settings.model } %>
      <% choices.unshift([t("settings.unavailable_option", name: @settings.model_changed? ? @settings.model : @settings.model_label), @settings.model]) %>
    <% end %>
    <%= form.select :model, choices, {}, aria: { describedby: "model-hint" }, class: "select mt-2 w-full border-base-content/50 bg-base-100 text-base" %>
    <p id="model-hint" class="mt-2 text-sm text-muted-ink"><%= t("settings.model_hint") %></p>
    <% if @catalog_unavailable %><p role="status" class="mt-3 text-sm"><%= t("settings.catalog_unavailable") %></p><% end %>
    <%= link_to t("settings.reload_models"), settings_path, class: "mt-2 inline-flex min-h-11 items-center text-sm text-primary underline underline-offset-4" %>
  </div>
  <div>
    <%= form.label :style_instructions, t("settings.style"), class: "block font-semibold" %>
    <%= form.text_area :style_instructions, rows: 5, maxlength: 1000, placeholder: t("settings.style_placeholder"),
      aria: { describedby: "style-hint" }, class: "textarea mt-2 w-full border-base-content/50 bg-base-100 text-base" %>
    <p id="style-hint" class="mt-2 text-sm text-muted-ink"><%= t("settings.style_hint") %></p>
  </div>
  <p class="text-sm leading-relaxed text-muted-ink"><%= t("settings.applies_to") %></p>
  <%= form.submit t("settings.save"), class: "btn btn-primary min-h-11 h-auto max-w-full py-3 whitespace-normal", data: { turbo_submits_with: t("settings.saving") } %>
<% end %>
